<editors>
  <!-- Boolean -->
  <editor id="bool">
    <range uom="2" subset="0,1" nls="BOOL" />
  </editor>

  <!-- Heat State -->
  <editor id="CLIHCS">
    <range uom="66" subset="0,1" nls="CLIHCS" />
  </editor>

  <!-- Mode Selection -->
  <editor id="MODE_SEL">
    <range uom="25" subset="1,2,3" nls="MODE" />
  </editor>

  <!-- Temperature Fahrenheit (Display & Driver) -->
  <editor id="tempF">
    <range uom="17" min="41" max="104" step="1" prec="0" />
    <range uom="25" subset="0,1" nls="HOLD_NAMES" />
  </editor>

  <!-- Temperature Fahrenheit (Command Input) -->
  <editor id="tempF_input">
    <range uom="17" min="41" max="104" step="1" prec="0" />
  </editor>

  <!-- Temperature Celsius (Display & Driver) -->
  <editor id="tempC">
    <range uom="4" min="5" max="40" step="1" prec="0" />
    <range uom="25" subset="0,1" nls="HOLD_NAMES" />
  </editor>

  <!-- Temperature Celsius (Command Input) -->
  <editor id="tempC_input">
    <range uom="4" min="5" max="40" step="1" prec="0" />
  </editor>

  <!-- Aliases for backwards compatibility / alternative editor references -->
  <editor id="CLITEMP_F">
    <range uom="17" min="41" max="104" step="1" prec="0" />
    <range uom="25" subset="0,1" nls="HOLD_NAMES" />
  </editor>

  <editor id="CLITEMP_F_INPUT">
    <range uom="17" min="41" max="104" step="1" prec="0" />
  </editor>

  <editor id="CLITEMP_C">
    <range uom="4" min="5" max="40" step="1" prec="0" />
    <range uom="25" subset="0,1" nls="HOLD_NAMES" />
  </editor>

  <editor id="CLITEMP_C_INPUT">
    <range uom="4" min="5" max="40" step="1" prec="0" />
  </editor>

  <!-- Hold End Time (Unix timestamp or special state) -->
  <editor id="HOLD_TIME">
    <range uom="25" subset="0,1" nls="HOLD_NAMES" />
    <range uom="151" min="0" max="4294967295" prec="0" />
  </editor>

  <!-- Hold Duration Minutes -->
  <editor id="HOLD_MINS">
    <range uom="45" min="0" max="1440" step="1" prec="0" />
  </editor>

  <!-- Power / Energy (kWh) -->
  <editor id="TPW">
    <range uom="33" min="0" max="100000" prec="2" />
  </editor>

  <!-- Timestamp (Epoch seconds) -->
  <editor id="timestamp">
    <range uom="151" min="0" max="4294967295" prec="0" />
  </editor>
</editors>

