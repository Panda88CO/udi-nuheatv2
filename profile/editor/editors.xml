<editors>
  <!-- Boolean -->
  <editor id="bool">
    <range uom="2" subset="0,1" nls="BOOL" />
  </editor>

  <!-- Heat State -->
  <editor id="CLIHCS">
    <range uom="66" subset="0,1" nls="CLIHCS" />
  </editor>

  <!-- Mode Selection -->
  <editor id="MODESEL">
    <range uom="25" subset="1,2,3" nls="MODE" />
  </editor>

  <!-- Temperature Fahrenheit (Display & Driver) -->
  <editor id="tempF">
    <range uom="17" min="41" max="104" prec="0" />
  </editor>

  <!-- Temperature Fahrenheit (Command Input) -->
  <editor id="tempFinput">
    <range uom="17" min="41" max="104" prec="0" step="1" />
  </editor>

  <!-- Temperature Celsius (Display & Driver) -->
  <editor id="tempC">
    <range uom="4" min="5" max="40" prec="0" />
  </editor>

  <!-- Temperature Celsius (Command Input) -->
  <editor id="tempCinput">
    <range uom="4" min="5" max="40" prec="0" step="1" />
  </editor>

  <!-- Hold End Time (Unix timestamp or special state) -->
  <editor id="HOLDTIME">
    <range uom="25" subset="0,1" nls="HOLDNAMES" />
    <range uom="151" min="0" max="4294967295" prec="0" />
  </editor>

  <!-- Hold Duration Minutes -->
  <editor id="HOLDMINS">
    <range uom="45" min="0" max="1440" prec="0" step="1" />
  </editor>

  <!-- Power / Energy (kWh) -->
  <editor id="TPW">
    <range uom="33" min="0" max="100000" prec="2" />
  </editor>

  <!-- Timestamp (Epoch seconds) -->
  <editor id="timestamp">
    <range uom="151" min="0" max="4294967295" prec="0" />
  </editor>
</editors>

